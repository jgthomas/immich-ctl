#!/usr/bin/env python3
"""Test INI credentials using only GET /api/users/me (requires user.read)."""

import argparse
import json
import math
import sys
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.request import HTTPRedirectHandler, Request, build_opener

from immich_ctl.config import ConfigError as PingError
from immich_ctl.config import load_config as load_account


class NoRedirects(HTTPRedirectHandler):
    # Never forward the API key to a redirect target, even on the same host.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def load_config(path: Path) -> tuple[str, str]:
    server, key = load_account(path)
    return server + "/users/me", key


def get_current_user(endpoint: str, key: str, timeout: float) -> dict[str, Any]:
    """Fetch the account owning the key without modifying the server."""
    request = Request(
        endpoint, headers={"x-api-key": key, "Accept": "application/json"}, method="GET"
    )
    try:
        with build_opener(NoRedirects()).open(request, timeout=timeout) as response:
            if response.status != 200:
                raise PingError(f"Unexpected HTTP status {response.status}.")
            payload = response.read(1024 * 1024 + 1)
    except HTTPError as error:
        status = error.code
        error.close()
        messages = {
            401: "Authentication failed (HTTP 401); check the API key.",
            403: "Access denied (HTTP 403); check that the key permits user.read.",
            404: "API endpoint not found (HTTP 404); check the server URL.",
        }
        if 300 <= status < 400:
            raise PingError(
                "Server redirected the request; set server to the final Immich URL. "
                "The API key was not forwarded."
            ) from None
        raise PingError(messages.get(status, f"Server returned HTTP {status}.")) from None
    except (URLError, OSError, ValueError):
        raise PingError(
            "Connection failed; check the URL, network and TLS certificate, or increase --timeout."
        ) from None
    if len(payload) > 1024 * 1024:
        raise PingError("Unexpected response: account JSON exceeds 1 MiB.")
    try:
        user = json.loads(payload)
    except (ValueError, UnicodeError):
        raise PingError("Server did not return valid JSON; check the server URL.") from None
    if not isinstance(user, dict) or not isinstance(user.get("id"), str) or not user["id"]:
        raise PingError("Unexpected response: no Immich user ID found.")
    return user


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config", required=True, type=Path, metavar="FILE", help="Account INI file"
    )
    parser.add_argument(
        "--timeout", type=float, default=15, metavar="SECONDS", help="Request timeout (default: 15)"
    )
    args = parser.parse_args(argv)
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        parser.error("--timeout must be a positive finite number")
    try:
        endpoint, key = load_config(args.config.expanduser())
        user = get_current_user(endpoint, key, args.timeout)
    except PingError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130

    def safe(value: object) -> str:
        # Quote remote strings and redact even an accidentally echoed API key.
        return json.dumps(str(value).replace(key, "[REDACTED]"), ensure_ascii=True)

    print("OK: credentials loaded and authenticated read-only request succeeded.")
    for label, field in (("Account", "name"), ("Email", "email"), ("User ID", "id")):
        if user.get(field):
            print(f"{label}: {safe(user[field])}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
