#!/usr/bin/env python3
"""Describe Google Photos Takeout ZIPs without extracting or modifying them."""

import argparse
import json
import re
import zipfile
from collections import Counter, defaultdict
from pathlib import Path

from immich_ctl.takeout import (
    capture_year,  # noqa: F401 -- retained for script callers
    counts,
    inspect_archives,
    media_type,
    print_table,
)


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Pass all ZIP parts from ONE person's export together. Requires Python 3 only.",
    )
    parser.add_argument("archives", nargs="+", type=Path, metavar="ZIP")
    parser.add_argument(
        "--details", action="store_true", help="List unresolved sidecars and unpaired file entries"
    )
    args = parser.parse_args(argv)
    paths = list(dict.fromkeys(path.expanduser().resolve() for path in args.archives))
    try:
        items, memberships, titles, raw, warnings, sidecars, coverage = inspect_archives(paths)
    except (OSError, zipfile.BadZipFile, RuntimeError, NotImplementedError) as error:
        parser.exit(2, f"Error reading Takeout: {error}\n")
    if not items and not raw and not titles:
        parser.exit(2, "No Google Photos content found in the supplied ZIPs.\n")

    print(f"Archives: {len(paths)}")
    print(f"Google Photos items described by JSON: {len(items):,}")
    print(f"Media JSON entries: {sidecars:,} (includes album copies)")
    print("\nCounts use Google Photos IDs to deduplicate album/year copies.")
    print("Years use photoTakenTime in UTC; missing/invalid dates are Unknown.")
    print("These are metadata counts, not checksums or visually deduplicated counts.")
    print("Live Photo clips, edits and files without JSON may add extra file entries.")
    print("Conflicting capture years are Unknown; conflicting media types are Other.")

    by_year: defaultdict[str, Counter[str]] = defaultdict(Counter)
    for year, kind in items.values():
        by_year[year][kind] += 1
    print("\nBy capture year")
    print_table("Year", [(year, by_year[year]) for year in sorted(by_year)])
    print_table("", [("TOTAL", counts(items, items))])

    # Confirmed albums need album metadata; folder-only guesses stay separate.
    inferred_albums = {
        directory
        for directory in set(memberships) | coverage.directories
        if directory not in titles
        and directory != "."
        and directory not in {"Archive", "Trash", "Failed videos"}
        and not re.fullmatch(r"Photos from \d{4}", directory)
    }
    title_counts = Counter(titles.values())
    rows = []
    for directory, title in titles.items():
        if title_counts[title] > 1:
            title = f"{title} [folder: {directory}]"
        rows.append((title, counts(memberships[directory], items)))
    print(f"\nBy album ({len(titles):,} confirmed by album metadata; items can belong to several)")
    print_table("Album", sorted(rows, key=lambda row: row[0].casefold()))
    if inferred_albums:
        print("\nPossible album folders (no album metadata; counts describe JSON items only)")
        print_table(
            "Folder",
            [
                (name, counts(memberships.get(name, set()), items))
                for name in sorted(inferred_albums)
            ],
        )

    print("\nMetadata-to-file coverage (filename matches, not media-content validation)")
    print(
        f"Items with a confirmed media file in at least one folder: {len(coverage.matched_items):,}"
    )
    print(f"Items with only ambiguous media matches: {len(coverage.ambiguous_items):,}")
    print(f"Items without a media filename match: {len(coverage.missing_items):,}")
    print(
        f"Sidecars without a match in their own folder: {coverage.sidecars_without_local_match:,}"
    )
    print(f"Sidecars with ambiguous matches: {coverage.ambiguous_sidecars:,}")
    print("A missing local match can be covered by another album/year copy with the same ID.")

    print("\nZIP file inventory (includes album copies and companion files)")
    print_table("Files", [("Media", Counter({k: raw[k] for k in ("Photos", "Videos")}))])
    print(f"Other non-JSON file entries: {raw['Other']:,}")
    print_table(
        "Unpaired files",
        [("No confirmed sidecar", Counter(media_type(key[0]) for key in coverage.unmatched_files))],
    )
    print("Unpaired files can include edits, Live Photo clips, ambiguous matches or missing JSON.")
    print("They are not added to metadata year/album counts or assumed to be duplicates.")
    if coverage.missing_items or coverage.ambiguous_items or coverage.unmatched_files:
        print("Use --details to list unresolved sidecars and unpaired file entries.")
    if args.details:
        for label, identities in (
            ("Missing media match", coverage.missing_items),
            ("Ambiguous media match", coverage.ambiguous_items),
        ):
            for name in sorted(
                {name for identity in identities for name in coverage.item_paths[identity]}
            ):
                print(f"{label}: {json.dumps(name, ensure_ascii=True)}")
        for name, crc, size in sorted(coverage.unmatched_files):
            print(
                f"Unpaired file: {json.dumps(name, ensure_ascii=True)} "
                f"(size={size}, CRC32={crc:08x})"
            )
    if warnings:
        print("\nWarnings")
        for message, number in sorted(warnings.items()):
            print(f"  {message}: {number:,}")


if __name__ == "__main__":
    main()
